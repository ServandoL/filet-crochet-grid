# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# MongoDB cluster connection string (e.g. MongoDB Atlas or your own replica set)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database name
MONGO_DB_NAME=<name>

# Secret used for JWT signing – use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

